# Required
DATABASE_URL=postgres://sp:sp@localhost:5432/scripturepath
# Public URL of the app. Used for links in emails and the Google OAuth redirect.
APP_URL=http://localhost:3000
# Port the API listens on. In dev, Vite proxies /api to this port.
PORT=3000
# Receives the "new member" alert when someone verifies their email.
ADMIN_EMAIL=you@example.com

# Email (optional). Without RESEND_API_KEY, verification codes and alerts
# are written to the server log only.
RESEND_API_KEY=
MAIL_FROM=ScripturePath <noreply@example.com>

# Google Calendar sync (optional). Redirect URI: <APP_URL>/api/calendar/callback
# Scope: https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bible chapter text (optional). Without it, the KJV fallback is used.
API_BIBLE_KEY=
