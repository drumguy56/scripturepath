{
  "name": "StudyGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "study_id": {
      "type": "string"
    },
    "study_title": {
      "type": "string"
    },
    "invite_code": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "member_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "schedule_start": {
      "type": "string",
      "format": "date"
    },
    "schedule_time": {
      "type": "string"
    },
    "schedule_cadence": {
      "type": "string",
      "enum": [
        "Weekly",
        "Every other week"
      ],
      "enumColors": [
        "green",
        "blue"
      ],
      "default": "Weekly"
    }
  },
  "required": [
    "name",
    "invite_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}